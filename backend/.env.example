# Copy to backend/.env and fill in. Leave LLM_API_KEY empty to run without an LLM.

# Any OpenAI-compatible endpoint, for example:
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.0-flash
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1                           LLM_MODEL=llama-3.3-70b-versatile
#   OpenAI:     LLM_BASE_URL=                                                         LLM_MODEL=gpt-4o-mini
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama            LLM_MODEL=llama3.1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Model used to read KYC documents (must accept images). Defaults to LLM_MODEL.
LLM_VISION_MODEL=

CORS_ORIGINS=http://localhost:3000
APP_TODAY=2026-07-15

# WhatsApp Cloud API (optional): webhook at /api/whatsapp/webhook
WA_VERIFY_TOKEN=udyam-verify
WA_TOKEN=
WA_PHONE_ID=
PUBLIC_APP_URL=http://localhost:3000
